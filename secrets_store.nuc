use os
use secrets
use shutil
use subprocess
use time
use pathlib{ Path }

SECRET_SERVICE = "nuclear-graph"
// How long a closed keyring is waited for, in seconds: a service that starts at login runs before the keyring opens.
KEYRING_WAIT = 90

// The two secrets of the graph: the key that encrypts its documents and the owner's token. They live in the desktop
// keyring (libsecret's `secret-tool`); without one, in files of the data folder readable only by the owner. The names
// the keyring keeps are written down (`.keyring`, no secret in it): a keyring that does not answer for one of them is
// closed, and the secret is waited for, never made again (a second key would open no card, a second owner's token
// would be one the user's tools do not have).
Secrets
  // MCP clients start servers with a minimal environment: find the user's session bus (where the keyring is).
  static env() <string, string>
    found: <string, string> = dict(os.environ)
    if not ("DBUS_SESSION_BUS_ADDRESS" in found) and hasattr(os, "getuid")
      bus = "/run/user/${os.getuid()}/bus"
      if os.path.exists(bus)
        found["DBUS_SESSION_BUS_ADDRESS"] = "unix:path=${bus}"
    found

  static keyring() boolean
    off: string = os.environ.get("NUCLEAR_GRAPH_NO_KEYRING") ?? ""
    off.length == 0 and shutil.which("secret-tool") != null

  static keyringGet(name: string) string?
    if not Secrets.keyring()
      return null
    r = subprocess.run(["secret-tool", "lookup", "service", SECRET_SERVICE, "secret", name], captureOutput = true, text = true, env = Secrets.env())
    out: string = r.stdout
    if r.returncode != 0 or out.trim().length == 0
      return null
    Secrets.note(name)
    out.trim()

  static keyringSet(name: string, value: string) boolean
    if not Secrets.keyring()
      return false
    r = subprocess.run(["secret-tool", "store", "--label=Nuclear Smart Graph ${name}", "service", SECRET_SERVICE, "secret", name], input = value, text = true, captureOutput = true, env = Secrets.env())
    if r.returncode != 0
      return false
    Secrets.note(name)
    true

  static fileOf(name: string) Path
    Paths.home().joinpath(".${name}")

  // A file only the owner reads (0600).
  static write(file: Path, value: string) void
    file.touch(mode = 384)
    file.writeText(value)
    os.chmod(file, 384)

  // The names of the secrets the keyring keeps for this graph.
  static noted() string[]
    file = Secrets.fileOf("keyring")
    if not file.isFile()
      return []
    text: string = file.readText()
    text.split("\n").filter((line) => line.length > 0)

  static note(name: string) void
    names = Secrets.noted()
    if not (name in names)
      Secrets.write(Secrets.fileOf("keyring"), [...names, name].join("\n"))

  // The secret `name`, made with `make()` the first time. One the keyring keeps while the keyring is closed is
  // waited for (`wait` seconds), then refused: a graph started by the system starts again until the keyring opens.
  static secret(name: string, make: () => string, wait: int = KEYRING_WAIT) string
    kept = Secrets.find(name)
    waited = 0
    while kept == null and Secrets.closed(name) and waited < wait
      time.sleep(1)
      waited += 1
      kept = Secrets.find(name)
    if kept != null
      return kept!
    if Secrets.closed(name)
      throw RuntimeError("the keyring that keeps the graph's `${name}` is closed: open it (log in) and start the graph again")
    made = make()
    if not Secrets.keyringSet(name, made)
      Secrets.write(Secrets.fileOf(name), made)
    made

  // Whether the keyring keeps `name` and does not answer for it now.
  static closed(name: string) boolean
    Secrets.keyring() and name in Secrets.noted() and Secrets.keyringGet(name) == null

  static newKey() string
    raw: Bytes = secrets.tokenBytes(32)
    raw.toBase64()

  // The AES-256 key of the documents.
  static key() Bytes
    Bytes.fromBase64(Secrets.secret("key", () => Secrets.newKey()))

  // The token of the graph's owner (the user's CLI and editor): every scope.
  static ownerToken() string
    Secrets.secret("owner", () => secrets.tokenUrlsafe(32))

  // The secret `name` if it was kept, or null (never made here).
  static find(name: string) string?
    value = Secrets.keyringGet(name)
    if value != null
      return value
    file = Secrets.fileOf(name)
    // what the keyring keeps is not read from a file: one made while the keyring was closed is another secret
    if not file.isFile() or (Secrets.keyring() and name in Secrets.noted())
      return null
    text: string = file.readText()
    text.trim()

  // Keeps a secret given by the user (a search key) in the keyring, or in a file only the owner reads.
  static keep(name: string, value: string) void
    if not Secrets.keyringSet(name, value)
      Secrets.write(Secrets.fileOf(name), value)

use os
use pathlib{ Path }

// The graph's secrets: kept in the keyring, and never made twice while the keyring is closed.

testASecretOfAClosedKeyringIsRefusedAndNeverMadeAgain(tmpPath: Path, monkeypatch: any) void
  // a keyring that keeps its secrets in a folder, and is closed while the folder has a file `closed`
  kept = tmpPath.joinpath("kept")
  kept.mkdir()
  tool = tmpPath.joinpath("bin", "secret-tool")
  tool.parent.mkdir()
  tool.writeText("#!/bin/sh\n[ -e '${kept}/closed' ] && exit 1\nif [ \"$1\" = lookup ]; then cat \"${kept}/$5\" 2>/dev/null || exit 1; else cat > \"${kept}/$6\"; fi\n")
  os.chmod(tool, 493)
  home = tmpPath.joinpath("home")
  monkeypatch.setenv("PATH", "${tool.parent}:${os.environ["PATH"]}")
  monkeypatch.setenv("NUCLEAR_GRAPH_HOME", "${home}")
  monkeypatch.delenv("NUCLEAR_GRAPH_NO_KEYRING", raising = false)
  expect(Secrets.secret("owner", () => "one", 0) == "one")
  expect(kept.joinpath("owner").readText() == "one" and not home.joinpath(".owner").exists() and Secrets.noted() == ["owner"])
  // closed (a service that starts at login runs before the keyring opens): the secret is there and cannot be read;
  // no other one is made, in the keyring nor in a file
  closed = kept.joinpath("closed")
  closed.touch()
  refused = false
  try
    Secrets.secret("owner", () => "two", 0)
  catch e
    refused = true
  expect(refused and Secrets.find("owner") == null and not home.joinpath(".owner").exists())
  // a secret the keyring never kept is made in a file, as on a machine without a keyring
  expect(Secrets.secret("fresh", () => "made", 0) == "made" and home.joinpath(".fresh").readText() == "made")
  // a file made while it was closed is not the secret the keyring keeps
  home.joinpath(".owner").writeText("another")
  expect(Secrets.find("owner") == null)
  closed.unlink()
  expect(Secrets.secret("owner", () => "three", 0) == "one")
